# Server
NODE_ENV=
PORT=

# PostgreSQL (Prisma) — host port 5433 avoids conflict with a local Postgres on 5432
DATABASE_URL=postgresql://sprintly:sprintly@localhost:5433/sprintly

# Redis
REDIS_URL=

# JWT access tokens (e.g. 15m)
JWT_SECRET=
JWT_EXPIRES_IN=

# Refresh tokens — Redis TTL (e.g. 7d)
JWT_REFRESH_EXPIRES_IN=

# CORS
CORS_ORIGIN=
